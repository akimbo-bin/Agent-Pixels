{
  "name": "@agent-pixels/paperclip-plugin",
  "version": "0.1.0",
  "description": "Security camera style pixel office plugin for Paperclip",
  "type": "module",
  "private": true,
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "world:build": "python scripts/build-illustrated-editor.py --serve-copy",
    "world:release": "node scripts/deploy-illustrated-world.mjs",
    "world:deploy": "node scripts/deploy-illustrated-world.mjs --root C:/NebulaWorld",
    "world:serve": "node scripts/nebula-world-server.mjs",
    "world:check-mobile": "node scripts/check-mobile-world.cjs",
    "world:rollback": "node scripts/rollback-illustrated-world.mjs --root C:/NebulaWorld"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
