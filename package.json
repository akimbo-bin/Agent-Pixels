{
  "name": "@agent-pixels/paperclip-plugin",
  "version": "0.1.0",
  "description": "Security camera style pixel office plugin for Paperclip",
  "type": "module",
  "private": true,
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "world:build": "node scripts/build-telemetry-validator.mjs && python scripts/build-illustrated-editor.py --serve-copy",
    "world:release": "node scripts/deploy-illustrated-world.mjs",
    "world:deploy": "node scripts/deploy-world-ct125.mjs",
    "world:serve": "node scripts/nebula-world-server.mjs",
    "world:check-mobile": "node scripts/check-mobile-world.cjs",
    "world:rollback": "node scripts/rollback-world-ct125.mjs",
    "world:deploy-local": "node scripts/deploy-illustrated-world.mjs --root C:/NebulaWorld",
    "world:rollback-local": "node scripts/rollback-illustrated-world.mjs --root C:/NebulaWorld",
    "world:check-dashboard": "node scripts/check-dashboard.cjs",
    "world:check-dashboard-mobile": "node scripts/check-dashboard-mobile.cjs",
    "world:check-data": "node scripts/check-training-dashboard.cjs && node scripts/check-render-counts.cjs && node scripts/check-listening-api.cjs",
    "world:check-telemetry": "node scripts/check-office-telemetry.mjs && node scripts/check-office-connection.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "ajv": "^8.20.0",
    "esbuild": "^0.27.3",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
